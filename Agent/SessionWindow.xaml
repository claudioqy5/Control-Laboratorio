<Window x:Class="ControlLaboratorio.Agent.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sesión Activa" Height="60" Width="430"
        WindowStyle="None" Topmost="True" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual">
    <Border Background="#1E293B" CornerRadius="12" BorderBrush="#38BDF8" BorderThickness="1.5" Padding="15,5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.4" Direction="270" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="#4ADE80" Margin="0,0,10,0"/>
                <TextBlock x:Name="lblUser" Text="Cargando..." Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Width="120" TextTrimming="CharacterEllipsis"/>
                
                <Border Background="#0F172A" CornerRadius="4" Padding="8,4" Margin="10,0">
                    <TextBlock x:Name="lblTimer" Text="03:00:00" Foreground="#FACC15" FontSize="13" FontWeight="Bold" FontFamily="Consolas"/>
                </Border>

                <Rectangle Width="1" Fill="#334155" Margin="5,5,15,5" Height="20"/>
                <Button Content="CERRAR SESIÓN" Click="Logout_Click" Background="#EF4444" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Padding="12,6" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
