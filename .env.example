# ===================================================================
# BASE DE DATOS SQL SERVER (Docker)
# ===================================================================
MSSQL_SA_PASSWORD=YourSecurePasswordHere123!
ConnectionStrings__ControlLaboratorioConnection=Server=cl-db;Database=ControlLaboratorio;User Id=sa;Password=YourSecurePasswordHere123!;TrustServerCertificate=True;MultipleActiveResultSets=true

# ===================================================================
# CONFIGURACIÓN SMTP (CORREO)
# ===================================================================
SmtpSettings__Server=smtp.office365.com
SmtpSettings__Port=587
SmtpSettings__SenderEmail=tu_correo@urp.edu.pe
SmtpSettings__SenderName=Biblioteca / Control Laboratorio URP
SmtpSettings__Username=tu_correo@urp.edu.pe
SmtpSettings__Password=tu_password_de_correo
SmtpSettings__EnableSsl=true

# ===================================================================
# CREDENCIALES PANEL ADMINISTRADOR (WEB)
# ===================================================================
AdminSettings__Username=admin
AdminSettings__Password=tu_password_admin
AdminSettings__ActionPassword=tu_password_acciones
